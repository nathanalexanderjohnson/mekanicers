<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize 'Name'}}</div>
    <div class='item-prop armor-loc-head' title='Head'>H</div>
    <div class='item-prop armor-loc-chest' title='Chest'>C</div>
    <div class='item-prop armor-loc-arms' title='Arms'>A</div>
    <div class='item-prop armor-loc-legs' title='Legs'>L</div>
    <div class='item-prop armor-equipped' title='Equipped'>E</div>
    <div class='item-prop armor-avb' title='Blunt Armor Value'>AVB</div>
    <div class='item-prop armor-avp' title='Piercing Armor Value'>AVP</div>
    <div class='item-prop armor-avs' title='Slashing Armor Value'>AVS</div>
    <div class='item-prop armor-weight' title='Weight'>Wt</div>
    <div class='item-controls'>
      <a
        class='item-control item-create'
        title='{{localize "DOCUMENT.Create" type="Armor"}}'
        data-type='armor'
      >
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type='Armor'}}
      </a>
    </div>
  </li>
  {{#each armors as |item id|}}
    <li class='item flexrow' data-item-id='{{item._id}}'>
      <div class='item-name'>
        <div class='item-image'>
          <img
            src='{{item.img}}'
            title='{{item.name}}'
            width='24'
            height='24'
          />
        </div>
        <h4>{{item.name}}</h4>
      </div>
      <div class='item-prop armor-loc-head'>
        <a class='armor-toggle-location' data-location='locationHead' title='Toggle Head'>
          <i class='fas fa-circle' style='{{#unless item.system.locationHead}}opacity: 0.2;{{/unless}}'></i>
        </a>
      </div>
      <div class='item-prop armor-loc-chest'>
        <a class='armor-toggle-location' data-location='locationChest' title='Toggle Chest'>
          <i class='fas fa-circle' style='{{#unless item.system.locationChest}}opacity: 0.2;{{/unless}}'></i>
        </a>
      </div>
      <div class='item-prop armor-loc-arms'>
        <a class='armor-toggle-location' data-location='locationArms' title='Toggle Arms'>
          <i class='fas fa-circle' style='{{#unless item.system.locationArms}}opacity: 0.2;{{/unless}}'></i>
        </a>
      </div>
      <div class='item-prop armor-loc-legs'>
        <a class='armor-toggle-location' data-location='locationLegs' title='Toggle Legs'>
          <i class='fas fa-circle' style='{{#unless item.system.locationLegs}}opacity: 0.2;{{/unless}}'></i>
        </a>
      </div>
      <div class='item-prop armor-equipped'>
        <a class='armor-toggle-equipped' title='Toggle Equipped'>
          <i class='fas fa-shield-alt' style='{{#unless item.system.equipped}}opacity: 0.2;{{/unless}}'></i>
        </a>
      </div>
      <div class='item-prop armor-avb'>{{item.system.avb}}</div>
      <div class='item-prop armor-avp'>{{item.system.avp}}</div>
      <div class='item-prop armor-avs'>{{item.system.avs}}</div>
      <div class='item-prop armor-weight'>{{item.system.weight}}</div>
      <div class='item-controls'>
        <a
          class='item-control item-edit'
          title='{{localize "DOCUMENT.Update" type="Item"}}'
        >
          <i class='fas fa-edit'></i>
        </a>
        <a
          class='item-control item-delete'
          title='{{localize "DOCUMENT.Delete" type="Item"}}'
        >
          <i class='fas fa-trash'></i>
        </a>
      </div>
    </li>
  {{/each}}
</ol>
