<div class='armor-tracker'>
  <div class='armor-silhouette-wrap'>

    <img
      class='armor-silhouette-img'
      src='systems/mekanicers/assets/silhouette.png'
      alt='Body Silhouette'
    />

    {{!-- Head --}}
    <div class='armor-zone armor-zone-head'>
      <div class='zone-label'>Head</div>
      <div class='zone-avs'>
        <div class='av-entry'>
          <span class='av-label'>AVB</span>
          <span class='av-value'>{{armorTracker.head.avb}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVP</span>
          <span class='av-value'>{{armorTracker.head.avp}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVS</span>
          <span class='av-value'>{{armorTracker.head.avs}}</span>
        </div>
      </div>
    </div>

    {{!-- Arms --}}
    <div class='armor-zone armor-zone-arms'>
      <div class='zone-label'>Arms</div>
      <div class='zone-avs'>
        <div class='av-entry'>
          <span class='av-label'>AVB</span>
          <span class='av-value'>{{armorTracker.arms.avb}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVP</span>
          <span class='av-value'>{{armorTracker.arms.avp}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVS</span>
          <span class='av-value'>{{armorTracker.arms.avs}}</span>
        </div>
      </div>
    </div>

    {{!-- Chest --}}
    <div class='armor-zone armor-zone-chest'>
      <div class='zone-label'>Chest</div>
      <div class='zone-avs'>
        <div class='av-entry'>
          <span class='av-label'>AVB</span>
          <span class='av-value'>{{armorTracker.chest.avb}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVP</span>
          <span class='av-value'>{{armorTracker.chest.avp}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVS</span>
          <span class='av-value'>{{armorTracker.chest.avs}}</span>
        </div>
      </div>
    </div>

    {{!-- Legs --}}
    <div class='armor-zone armor-zone-legs'>
      <div class='zone-label'>Legs</div>
      <div class='zone-avs'>
        <div class='av-entry'>
          <span class='av-label'>AVB</span>
          <span class='av-value'>{{armorTracker.legs.avb}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVP</span>
          <span class='av-value'>{{armorTracker.legs.avp}}</span>
        </div>
        <div class='av-entry'>
          <span class='av-label'>AVS</span>
          <span class='av-value'>{{armorTracker.legs.avs}}</span>
        </div>
      </div>
    </div>

  </div>
</div>
