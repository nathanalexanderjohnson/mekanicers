<div class="boons-banes-container grid grid-2col">
  {{!-- Boons Section --}}
  <div class="boons-section">
    <h3>{{localize 'MEKANICERS.Item.Boon.Boons'}}</h3>
    <ol class='items-list'>
      <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Name'}}</div>
        <div class='item-cost'>{{localize 'Cost'}}</div>
        <div class='item-controls'>
          <a
            class='item-control item-create'
            title='{{localize "DOCUMENT.Create" type='Boon'}}'
            data-type='boon'
            data-boon-type='boon'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='Boon'}}
          </a>
        </div>
      </li>
      {{#each boons as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable' data-roll-type='item'>
                <img
                  src='{{item.img}}'
                  title='{{item.name}}'
                  width='24'
                  height='24'
                />
              </a>
            </div>
            <h4>{{item.name}}</h4>
          </div>
          <div class='item-cost item-prop'>{{item.system.cost}}</div>
          <div class='item-controls'>
            <a
              class='item-control item-edit'
              title='{{localize "DOCUMENT.Update" type='Item'}}'
            >
              <i class='fas fa-edit'></i>
            </a>
            <a
              class='item-control item-delete'
              title='{{localize "DOCUMENT.Delete" type='Item'}}'
            >
              <i class='fas fa-trash'></i>
            </a>
          </div>
        </li>
      {{/each}}
    </ol>
  </div>

  {{!-- Banes Section --}}
  <div class="banes-section">
    <h3>{{localize 'MEKANICERS.Item.Boon.Banes'}}</h3>
    <ol class='items-list'>
      <li class='item flexrow items-header'>
        <div class='item-name'>{{localize 'Name'}}</div>
        <div class='item-cost'>{{localize 'Cost'}}</div>
        <div class='item-controls'>
          <a
            class='item-control item-create'
            title='{{localize "DOCUMENT.Create" type='Bane'}}'
            data-type='boon'
            data-boon-type='bane'
          >
            <i class='fas fa-plus'></i>
            {{localize 'DOCUMENT.New' type='Bane'}}
          </a>
        </div>
      </li>
      {{#each banes as |item id|}}
        <li class='item flexrow' data-item-id='{{item._id}}'>
          <div class='item-name'>
            <div class='item-image'>
              <a class='rollable' data-roll-type='item'>
                <img
                  src='{{item.img}}'
                  title='{{item.name}}'
                  width='24'
                  height='24'
                />
              </a>
            </div>
            <h4>{{item.name}}</h4>
          </div>
          <div class='item-cost item-prop'>{{item.system.cost}}</div>
          <div class='item-controls'>
            <a
              class='item-control item-edit'
              title='{{localize "DOCUMENT.Update" type='Item'}}'
            >
              <i class='fas fa-edit'></i>
            </a>
            <a
              class='item-control item-delete'
              title='{{localize "DOCUMENT.Delete" type='Item'}}'
            >
              <i class='fas fa-trash'></i>
            </a>
          </div>
        </li>
      {{/each}}
    </ol>
  </div>
</div>
