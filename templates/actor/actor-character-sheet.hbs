<form class="{{cssClass}} {{actor.type}} flexcol" autocomplete="off">

  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <div class="avatar-circle">
      <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="110" width="110"/>
      {{#each system.attributes as |attribute key|}}
      <div class="attribute">
        <label class="resource-label rollable" for="system.attributes.{{key}}.value" data-roll-type="attribute" data-key="{{key}}" data-label="{{localize (lookup @root.config.attributes key)}}">{{localize (lookup @root.config.attributeAbbreviations key)}}</label>
        <input type="text" name="system.attributes.{{key}}.value" value="{{attribute.value}}" data-dtype="Number"/>
      </div>
      {{/each}}
      <div class="xp-tracker">
        <label class="resource-label">XP</label>
        <div class="resource-content">
          <input type="text" name="system.xp.value" value="{{system.xp.value}}" data-dtype="Number"/>
          <span>/</span>
          <input type="text" name="system.xp.max" value="{{system.xp.max}}" data-dtype="Number"/>
        </div>
      </div>
    </div>
    <div class="header-fields">
      <div class="flexrow flex-group-right magic-type">
        <select name="system.magicType">
          <option value="none" {{#if (equals system.magicType "none")}}selected{{/if}}>None</option>
          <option value="mekanicer" {{#if (equals system.magicType "mekanicer")}}selected{{/if}}>Mekanicer</option>
          <option value="sorcerer" {{#if (equals system.magicType "sorcerer")}}selected{{/if}}>Sorcerer</option>
        </select>
      </div>
      <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="Name"/></h1>
      {{!-- The grid classes are defined in scss/global/_grid.scss. To use,
      use both the "grid" and "grid-Ncol" class where "N" can be any number
      from 1 to 12 and will create that number of columns.  --}}
      <div class="resources grid grid-4col">

        {{!-- Row 1: one item per column --}}
        <div class="resource">
          <label for="system.combatantRank.value" class="resource-label">Combatant Rank</label>
          <input type="text" name="system.combatantRank.value" value="{{system.combatantRank.value}}" data-dtype="Number"/>
        </div>

        <div class="resource">
          <label for="system.reputation.value" class="resource-label">Reputation</label>
          <input type="text" name="system.reputation.value" value="{{system.reputation.value}}" data-dtype="Number"/>
        </div>

        <div class="resource">
          <label for="system.stress.value" class="resource-label">Stress</label>
          <div class="resource-content">
            <input type="text" name="system.stress.value" value="{{system.stress.value}}" data-dtype="Number"/>
            <span>/</span>
            <input type="text" name="system.stress.max" value="{{system.stress.max}}" data-dtype="Number" readonly/>
          </div>
        </div>

        <div class="resource">
          <label for="system.pain.value" class="resource-label">Pain</label>
          <div class="resource-content">
            <input type="text" name="system.pain.value" value="{{system.pain.value}}" data-dtype="Number" readonly/>
            <span>/</span>
            <input type="text" name="system.pain.max" value="{{system.pain.max}}" data-dtype="Number" readonly/>
          </div>
        </div>

        <div class="resource">
          <label for="system.luck.value" class="resource-label">Luck</label>
          <div class="resource-content">
            <input type="text" name="system.luck.value" value="{{system.luck.value}}" data-dtype="Number"/>
            <span>/</span>
            <input type="text" name="system.luck.max" value="{{system.luck.max}}" data-dtype="Number"/>
          </div>
        </div>

        {{!-- Row 2: paired beneath their row-1 partners --}}
        <div class="resource">
          <label for="system.speed.value" class="resource-label">Speed</label>
          <input type="text" name="system.speed.value" value="{{system.speed.value}}" data-dtype="Number"/>
        </div>

        <div class="resource">
          <label for="system.stamina.value" class="resource-label">Stamina</label>
          <div class="resource-content">
            <input type="text" name="system.stamina.value" value="{{system.stamina.value}}" data-dtype="Number"/>
            <span>/</span>
            <input type="text" name="system.stamina.max" value="{{system.stamina.max}}" data-dtype="Number" readonly/>
          </div>
        </div>

        <div class="resource">
          <label for="system.carryingCapacity.value" class="resource-label">Carrying Capacity</label>
          <div class="resource-content">
            <input type="text" name="system.carryingCapacity.value" value="{{system.carryingCapacity.value}}" data-dtype="Number" readonly/>
            <span>/</span>
            <input type="text" name="system.carryingCapacity.max" value="{{system.carryingCapacity.max}}" data-dtype="Number" readonly/>
          </div>
        </div>


      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    {{!-- Default tab is specified in actor-sheet.mjs --}}
    <a class="item" data-tab="features">Skills</a>
    <a class="item" data-tab="items">Items</a>
    <a class="item" data-tab="boons">Boons / Banes</a>
    {{#if (equals system.magicType "mekanicer")}}<a class="item" data-tab="mekanicer">Mekanicer</a>{{/if}}
    {{#if (equals system.magicType "sorcerer")}}<a class="item" data-tab="sorcerer">Sorcerer</a>{{/if}}
    <a class="item" data-tab="description">Notes</a>
    <a class="item" data-tab="effects">Effects</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">

    {{!-- Skills Tab --}}
    <div class="tab features" data-group="primary" data-tab="features">
      <div class="skills-combat-grid">

        {{!-- Skill groups: physical (left), social (center), professional (right) --}}
        {{#each skillGroups as |group|}}
        <div class="skill-col skill-col-{{group.key}}">
          <div class="skill-group">
            <h4 class="skill-group-label">{{group.label}}</h4>
            {{#each group.skills as |skill|}}
            <div class="skill">
              <label for="system.skills.{{skill.key}}.value" class="resource-label rollable" data-roll-type="skill" data-key="{{skill.key}}" data-label="{{skill.label}}">{{skill.label}}</label>
              <input type="text" name="system.skills.{{skill.key}}.value" value="{{skill.value}}" data-dtype="Number"/>
            </div>
            {{/each}}
          </div>
        </div>
        {{/each}}

        {{!-- Maneuvers: right of physical skills --}}
        <div class="maneuvers-section">
          <ol class="items-list">
            <li class="item flexrow items-header">
              <div class="item-name">{{localize 'Name'}}</div>
              <div class="item-tags">{{localize 'Tags'}}</div>
              <div class="item-cost">{{localize 'Cost'}}</div>
              <div class="item-tempo">Tempo</div>
              <div class="item-controls">
                <a class="item-control item-create" title='{{localize "DOCUMENT.Create" type="Maneuver"}}' data-type="maneuver">
                  <i class="fas fa-plus"></i> {{localize 'DOCUMENT.New' type='Maneuver'}}
                </a>
              </div>
            </li>
            {{#each maneuvers as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <div class="item-name">
                <div class="item-image">
                  <a class="rollable" data-roll-type="item">
                    <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                  </a>
                </div>
                <h4>{{item.name}}</h4>
              </div>
              <div class="item-tags item-prop">{{#each item.system.tags}}<span class="tag">{{this}}</span>{{/each}}</div>
              <div class="item-cost item-prop">{{item.system.cost}}</div>
              <div class="item-tempo item-prop">{{#if item.system.requiresTempo}}<i class="fas fa-check"></i>{{/if}}</div>
              <div class="item-controls">
                <a class="item-control item-use" title='{{localize "DOCUMENT.Use" type="Item"}}'><i class="fas fa-comment"></i></a>
                <a class="item-control item-edit" title='{{localize "DOCUMENT.Update" type="Item"}}'><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title='{{localize "DOCUMENT.Delete" type="Item"}}'><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          </ol>
        </div>

        {{!-- Wounds: below professional skills --}}
        <div class="wounds-section">
          <ol class="items-list wounds-list">
            <li class="item flexrow items-header">
              <div class="item-name">Wounds</div>
              <div class="item-formula">Pain</div>
              <div class="item-prop wound-bleeding-col" title="Bleeding">B</div>
              <div class="item-prop wound-treated-col" title="Treated">T</div>
              <div class="item-controls">
                <a class="item-control item-create" title="Create wound" data-type="wound">
                  <i class="fas fa-plus"></i> New Wound
                </a>
              </div>
            </li>
            {{#each wounds as |item id|}}
            <li class="item flexrow" data-item-id="{{item._id}}">
              <div class="item-name">
                <div class="item-image">
                  <a class="rollable" data-roll-type="item">
                    <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                  </a>
                </div>
                <h4>{{item.name}}</h4>
              </div>
              <div class="item-formula item-prop">{{item.system.pain}}</div>
              <div class="item-prop wound-bleeding-col">
                <a class="wound-toggle-bleeding" title="Toggle Bleeding">
                  <i class="fas fa-tint" style="{{#if item.system.bleeding}}{{#unless item.system.treated}}color: #c0392b;{{/unless}}{{/if}}{{#unless item.system.bleeding}}opacity: 0.2;{{/unless}}{{#if item.system.treated}}opacity: 0.1;{{/if}}"></i>
                </a>
              </div>
              <div class="item-prop wound-treated-col">
                <a class="wound-toggle-treated" title="Toggle Treated">
                  <i class="fas fa-band-aid" style="{{#if item.system.treated}}color: #27ae60;{{else}}opacity: 0.2;{{/if}}"></i>
                </a>
              </div>
              <div class="item-controls">
                <a class="item-control item-edit" title='{{localize "DOCUMENT.Update" type="Item"}}'><i class="fas fa-edit"></i></a>
                <a class="item-control item-delete" title='{{localize "DOCUMENT.Delete" type="Item"}}'><i class="fas fa-trash"></i></a>
              </div>
            </li>
            {{/each}}
          </ol>
        </div>

      </div>
    </div>

    {{!-- Owned Items Tab --}}
    <div class="tab items" data-group="primary" data-tab="items">
      <div class="items-layout">
        <div class="items-sidebar">
          {{> "systems/mekanicers/templates/actor/parts/actor-armor-tracker.hbs"}}
        </div>
        <div class="items-main">
          {{> "systems/mekanicers/templates/actor/parts/actor-armor.hbs"}}
        </div>
      </div>
      {{> "systems/mekanicers/templates/actor/parts/actor-items.hbs"}}
    </div>

    {{!-- Owned Boons/Banes Tab --}}
    <div class="tab boons" data-group="primary" data-tab="boons">
      {{> "systems/mekanicers/templates/actor/parts/actor-boons.hbs"}}
    </div>

    {{!-- Mekanicer Tab --}}
    {{#if (equals system.magicType "mekanicer")}}
    <div class="tab mekanicer" data-group="primary" data-tab="mekanicer">
      <div class="mekanicer-content">

        <div class="mekanicer-attributes flexrow">
          <div class="thesis-field">
            <label class="resource-label">Thesis</label>
            <input type="text" name="system.thesis" value="{{system.thesis}}" placeholder="Thesis Name"/>
          </div>
          <div class="attribute tile">
            <label class="resource-label">Arithmetic Spark</label>
            <input type="number" name="system.arithmeticSpark" value="{{system.arithmeticSpark}}" min="0" max="10" data-dtype="Number"/>
          </div>
          <div class="attribute tile">
            <label class="resource-label">Flux</label>
            <div class="resource-content">
              <input type="text" name="system.flux.value" value="{{system.flux.value}}" data-dtype="Number"/>
              <span>/</span>
              <input type="text" name="system.flux.max" value="{{system.flux.max}}" data-dtype="Number"/>
            </div>
          </div>
        </div>

        <div class="breakthroughs-grid grid grid-3col">
          <div class="breakthrough-col">
            <h3 class="breakthrough-header">Kinetics</h3>
            <ol class="items-list">
              <li class="item flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control mekanicer-breakthrough-create" title="Add Breakthrough" data-field="kinetics"><i class="fas fa-plus"></i></a>
                </div>
              </li>
              {{#each system.breakthroughs.kinetics as |entry index|}}
              <li class="item flexrow" data-index="{{index}}" data-field="kinetics">
                <div class="item-name">
                  <input type="text" name="system.breakthroughs.kinetics.{{index}}.name" value="{{entry.name}}"/>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-breakthrough-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </li>
              {{/each}}
            </ol>
          </div>

          <div class="breakthrough-col">
            <h3 class="breakthrough-header">Matrices</h3>
            <ol class="items-list">
              <li class="item flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control mekanicer-breakthrough-create" title="Add Breakthrough" data-field="matrices"><i class="fas fa-plus"></i></a>
                </div>
              </li>
              {{#each system.breakthroughs.matrices as |entry index|}}
              <li class="item flexrow" data-index="{{index}}" data-field="matrices">
                <div class="item-name">
                  <input type="text" name="system.breakthroughs.matrices.{{index}}.name" value="{{entry.name}}"/>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-breakthrough-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </li>
              {{/each}}
            </ol>
          </div>

          <div class="breakthrough-col">
            <h3 class="breakthrough-header">Thermalworks</h3>
            <ol class="items-list">
              <li class="item flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control mekanicer-breakthrough-create" title="Add Breakthrough" data-field="thermalworks"><i class="fas fa-plus"></i></a>
                </div>
              </li>
              {{#each system.breakthroughs.thermalworks as |entry index|}}
              <li class="item flexrow" data-index="{{index}}" data-field="thermalworks">
                <div class="item-name">
                  <input type="text" name="system.breakthroughs.thermalworks.{{index}}.name" value="{{entry.name}}"/>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-breakthrough-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </li>
              {{/each}}
            </ol>
          </div>
        </div>

        <div class="expertise-grid grid grid-3col">
          <div class="expertise-col">
            <h3 class="expertise-header">Kinetics Expertise</h3>
            <ol class="items-list">
              <li class="item flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control mekanicer-expertise-create" title="Add Expertise" data-field="kinetics"><i class="fas fa-plus"></i></a>
                </div>
              </li>
              {{#each system.expertise.kinetics as |entry index|}}
              <li class="item flexrow" data-index="{{index}}" data-field="kinetics">
                <div class="item-name">
                  <input type="text" name="system.expertise.kinetics.{{index}}.name" value="{{entry.name}}"/>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-expertise-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </li>
              {{/each}}
            </ol>
          </div>

          <div class="expertise-col">
            <h3 class="expertise-header">Matrices Expertise</h3>
            <ol class="items-list">
              <li class="item flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control mekanicer-expertise-create" title="Add Expertise" data-field="matrices"><i class="fas fa-plus"></i></a>
                </div>
              </li>
              {{#each system.expertise.matrices as |entry index|}}
              <li class="item flexrow" data-index="{{index}}" data-field="matrices">
                <div class="item-name">
                  <input type="text" name="system.expertise.matrices.{{index}}.name" value="{{entry.name}}"/>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-expertise-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </li>
              {{/each}}
            </ol>
          </div>

          <div class="expertise-col">
            <h3 class="expertise-header">Thermalworks Expertise</h3>
            <ol class="items-list">
              <li class="item flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                  <a class="item-control mekanicer-expertise-create" title="Add Expertise" data-field="thermalworks"><i class="fas fa-plus"></i></a>
                </div>
              </li>
              {{#each system.expertise.thermalworks as |entry index|}}
              <li class="item flexrow" data-index="{{index}}" data-field="thermalworks">
                <div class="item-name">
                  <input type="text" name="system.expertise.thermalworks.{{index}}.name" value="{{entry.name}}"/>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-expertise-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </li>
              {{/each}}
            </ol>
          </div>
        </div>

        <div class="gadgets-section">
          <h3 class="gadgets-header">Gadgets</h3>
          <ol class="items-list">
            <li class="item flexrow items-header">
              <div class="item-name">Name</div>
              <div class="item-blueprint">Blueprint</div>
              <div class="item-total-complexity">Total</div>
              <div class="item-controls">
                <a class="item-control mekanicer-gadget-create" title="Add Gadget"><i class="fas fa-plus"></i></a>
              </div>
            </li>
            {{#each gadgets as |item id|}}
            <li class="item gadget-item" data-item-id="{{item._id}}">
              <div class="gadget-summary flexrow">
                <div class="item-name gadget-toggle" title="Toggle Augments">
                  <div class="item-image">
                    <a class="rollable" data-roll-type="item">
                      <img src="{{item.img}}" title="{{item.name}}" width="24" height="24"/>
                    </a>
                  </div>
                  <h4>{{item.name}}</h4>
                  <i class="fas fa-chevron-down gadget-chevron"></i>
                </div>
                <div class="item-blueprint">
                  {{item.system.baseBlueprint}}
                </div>
                <div class="item-total-complexity">
                  <span class="complexity-total">{{item.system.totalComplexity}}</span>
                </div>
                <div class="item-controls">
                  <a class="item-control mekanicer-gadget-edit" title="Edit"><i class="fas fa-edit"></i></a>
                  <a class="item-control mekanicer-gadget-delete" title="Delete"><i class="fas fa-trash"></i></a>
                </div>
              </div>
              {{#if item.system.augments.length}}
              <div class="gadget-details">
                <ul class="gadget-augments">
                  {{#each item.system.augments as |augment|}}
                  <li class="augment-entry">
                    <span class="augment-name">{{augment.name}}</span>
                    <span class="augment-cost">+{{augment.complexity}}</span>
                  </li>
                  {{/each}}
                </ul>
              </div>
              {{/if}}
            </li>
            {{/each}}
          </ol>
        </div>

      </div>
    </div>
    {{/if}}

    {{!-- Sorcerer Tab --}}
    {{#if (equals system.magicType "sorcerer")}}
    <div class="tab sorcerer" data-group="primary" data-tab="sorcerer">
      <div class="sorcerer-content">

        <div class="curse-widget">
          <div class="curse-label-wrapper">
            <div class="curse-label-display">
              <label class="curse-label">{{system.curseTitle}}</label>
            </div>
            <div class="curse-label-edit">
              <input type="text" class="curse-title-input" value="{{system.curseTitle}}"/>
              <div class="curse-edit-actions">
                <button class="curse-title-save">Save</button>
                <button class="curse-title-cancel">Cancel</button>
              </div>
            </div>
          </div>
          <div class="curse-dots">
            <a class="sorcerer-curse-dot {{#if (gte system.curse 1)}}filled{{/if}}" data-value="1"></a>
            <a class="sorcerer-curse-dot {{#if (gte system.curse 2)}}filled{{/if}}" data-value="2"></a>
            <a class="sorcerer-curse-dot {{#if (gte system.curse 3)}}filled{{/if}}" data-value="3"></a>
            <a class="sorcerer-curse-dot {{#if (gte system.curse 4)}}filled{{/if}}" data-value="4"></a>
            <a class="sorcerer-curse-dot {{#if (gte system.curse 5)}}filled{{/if}}" data-value="5"></a>
          </div>
        </div>

        <div class="sorcerer-top-row flexrow">
          <div class="attribute tile">
            <label class="resource-label">Arcane Might</label>
            <input type="number" name="system.arcaneMight" value="{{system.arcaneMight}}" min="0" max="10" data-dtype="Number"/>
          </div>
          <div class="attribute tile">
            <label class="resource-label">Source</label>
            <select name="system.sorcererSource">
              <option value="blood" {{#if (equals system.sorcererSource "blood")}}selected{{/if}}>Blood</option>
              <option value="pact" {{#if (equals system.sorcererSource "pact")}}selected{{/if}}>Pact</option>
              <option value="grove" {{#if (equals system.sorcererSource "grove")}}selected{{/if}}>Grove</option>
            </select>
          </div>
          <div class="attribute tile">
            <label class="resource-label">Field of Study</label>
            <select name="system.fieldOfStudy">
              <option value="deeps" {{#if (equals system.fieldOfStudy "deeps")}}selected{{/if}}>Study of the Deeps</option>
              <option value="mind" {{#if (equals system.fieldOfStudy "mind")}}selected{{/if}}>Study of the Mind</option>
              <option value="nature" {{#if (equals system.fieldOfStudy "nature")}}selected{{/if}}>Study of Nature</option>
              <option value="realms" {{#if (equals system.fieldOfStudy "realms")}}selected{{/if}}>Study of the Realms</option>
              <option value="soul" {{#if (equals system.fieldOfStudy "soul")}}selected{{/if}}>Study of the Soul</option>
            </select>
          </div>
        </div>

        <div class="sorcerer-bottom-row grid grid-4col">
          <div class="resource">
            <label class="resource-label">Sense the Unseen</label>
            <input type="text" name="system.senseTheUnseen.value" value="{{system.senseTheUnseen.value}}" data-dtype="Number"/>
          </div>
          <div class="resource">
            <label class="resource-label">Arcane Lore</label>
            <input type="text" name="system.arcaneLore.value" value="{{system.arcaneLore.value}}" data-dtype="Number"/>
          </div>
          <div class="resource">
            <label class="resource-label">Scourge</label>
            <div class="resource-content">
              <input type="text" name="system.scourge.value" value="{{system.scourge.value}}" data-dtype="Number"/>
              <span>/</span>
              <input type="text" name="system.scourge.max" value="{{system.scourge.max}}" data-dtype="Number"/>
            </div>
          </div>
          <div class="resource">
            <label class="resource-label">Mental Strain</label>
            <div class="resource-content">
              <input type="text" name="system.mentalStrain.value" value="{{system.mentalStrain.value}}" data-dtype="Number"/>
              <span>/</span>
